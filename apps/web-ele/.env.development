# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# scada-engine HTTP API (vite proxy → :8080)
VITE_SCADA_API_URL=/scada-api

# scada-engine MQTT-over-WS (direct to broker; avoid Vite proxy handshake issues)
# Match scada-engine -mqtt-ws-listen (this machine currently uses :8085)
VITE_SCADA_MQTT_URL=ws://127.0.0.1:8085/mqtt

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
